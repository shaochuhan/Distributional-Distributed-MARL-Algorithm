"""
VMAS Unified Environment Adapter
统一适配器，让所有算法（ia2c, ma2c, wpo等）都能在VMAS场景上运行
"""

import numpy as np
import torch
from vmas import make_env

# VMAS库的dtype不一致bug的workaround说明：
# VMAS 1.4.3-1.5.2版本在多处混用了torch.float和torch.float32，
# 在某些地方使用了Python字面量(如0.0)会被解释为float64
# 我们的解决方案是在step时将动作tensor转换为float64发送给VMAS
# 同时保持观测为float32以兼容float32网络


def discrete_to_continuous_action(action_idx, n_actions):
    """
    将离散动作索引映射为VMAS需要的连续动作向量
    
    对于2D动作空间（如wheel），将离散索引映射到方向：
    - 如果离散动作空间是4或5，映射到4个主方向+停止
    - 如果离散动作空间是8或9，映射到8个方向+停止
    
    Args:
        action_idx: 离散动作索引
        n_actions: 动作维度（例如：2D空间为2）
    
    Returns:
        numpy array: 形状为(n_actions,)的连续动作向量，范围[-1, 1]
    """
    idx = int(action_idx) if not isinstance(action_idx, int) else action_idx
    
    else:
        # 2D动作空间：映射到常见的离散方向
        # 假设5个动作：上(0)，下(1)，左(2)，右(3)，停止(4)
        # 注意：使用float64以匹配VMAS内部物理引擎的精度要求
        direction_map = {
            0: np.array([0.0, 1.0], dtype=np.float64),   # 上 (y+)
            1: np.array([0.0, -1.0], dtype=np.float64),  # 下 (y-)
            2: np.array([-1.0, 0.0], dtype=np.float64),  # 左 (x-)
            3: np.array([1.0, 0.0], dtype=np.float64),   # 右 (x+)
            4: np.array([0.0, 0.0], dtype=np.float64),   # 停止
        }
        # 如果索引超出范围，使用停止动作
        return direction_map.get(idx % 5, np.array([0.0, 0.0], dtype=np.float64))
    else:
        # 其他维度：使用one-hot编码
        action_vec = np.zeros(n_actions, dtype=np.float64)
        if idx < n_actions:
            action_vec[idx] = 1.0
        # 映射到[-1, 1]范围
        return action_vec * 2.0 - 1.0


class VmasUnifiedEnv:
    """
    VMAS环境的统一适配器
    
    提供与 Grid_World 和 CACCEnv 相同的接口
    支持所有算法：ia2c, ia2c_fp, ma2c_nc, ma2c_cnet, ma2c_cu, ma2c_dial, d2ac_cu, wpo_cu
    """
    
    def __init__(self, config):
        """
        初始化VMAS环境
        
        Args:
            config: ConfigParser对象，包含环境配置
        """
        # 从配置读取参数
        self.scenario_name = config.get('vmas_scenario', 'navigation')  # VMAS场景名
        self.name = f'vmas_{self.scenario_name}'  # 环境名称（用于日志等）
        self.n_agent = config.getint('n_agent', 4)
        self.num_envs = config.getint('num_envs', 1)  # 向量化环境数量
        self.max_steps = config.getint('max_steps', 200)
        self.device_name = config.get('device', 'cuda' if torch.cuda.is_available() else 'cpu')
        self.continuous_actions = config.getboolean('continuous_actions', True)
        self.agent = config.get('agent')  # 算法名称
        self.coop_gamma = config.getfloat('coop_gamma', 0.9)
        
        # 场景特定参数
        self.n_obstacles = config.getint('n_obstacles', 2)  # navigation场景
        self.shared_rew = config.getboolean('shared_rew', True)
        self.observe_all_goals = config.getboolean('observe_all_goals', False)
        self.energy_coeff = config.getfloat('energy_coeff', 0.02)  # dropout/dispersion场景能量惩罚系数
        
        # 创建VMAS环境
        self.vmas_env = make_env(
            scenario=self.scenario_name,
            num_envs=self.num_envs,
            device=self.device_name,
            continuous_actions=self.continuous_actions,
            max_steps=self.max_steps,
            # 场景特定kwargs
            n_agents=self.n_agent,
            **self._get_scenario_kwargs()
        )
        
        # 重置环境获取初始信息
        self._initial_reset()
        
        # 构建邻居mask和距离mask（用于共识更新算法）
        self.neighbor_mask = self._build_neighbor_mask()
        self.distance_mask = self._build_distance_mask()
        
        # 计算最大距离（用于共识更新）
        # 对于全连接图，最大距离为1
        self.max_distance = 1
        
        # 当前状态
        self.cur_step = 0
        self.done_flag = False
        
        # 时间步长属性（用于Trainer）
        self.T = self.max_steps
        self.t = 0  # 当前episode的时间步
        
    def _get_scenario_kwargs(self):
        """根据场景返回特定参数"""
        if self.scenario_name == 'navigation':
            return {
                'n_obstacles': self.n_obstacles,
                'shared_rew': self.shared_rew,
                'observe_all_goals': self.observe_all_goals,
            }
        elif self.scenario_name == 'transport':
            return {
                'n_packages': 1,
                'package_mass': 50,
                'package_width': 0.15,
                'package_length': 0.15,
            }
        elif self.scenario_name == 'balance':
            return {
                'random_package_pos_on_line': True,
            }
        elif self.scenario_name == 'sampling':
            return {
                'n_gaussians': 4,
                'shared_rew': self.shared_rew,
            }
        elif self.scenario_name == 'flocking':
            return {
                'n_obstacles': self.n_obstacles,
            }
        elif self.scenario_name == 'discovery':
            return {
                'n_targets': 5,
                'agents_per_target': 2,
            }
        elif self.scenario_name == 'dropout':
            return {
                'energy_coeff': self.energy_coeff,
            }
        elif self.scenario_name == 'dispersion':
            return {
                'energy_coeff': self.energy_coeff,
            }
        else:
            return {}
    
    def _initial_reset(self):
        """初始重置，获取环境信息"""
        obs = self.vmas_env.reset()
        
        # 处理观测空间
        if isinstance(obs, dict):
            # Dict空间
            self.obs_dict_mode = True
            agent_names = list(obs.keys())
            self.n_agent = len(agent_names)
            sample_obs = obs[agent_names[0]]
        else:
            # Tuple空间
            self.obs_dict_mode = False
            self.n_agent = len(obs)
            sample_obs = obs[0]
        
        # 确定状态和动作维度
        if isinstance(sample_obs, dict):
            # 嵌套观测
            self.n_s = sum([v.shape[-1] for v in sample_obs.values()])
        else:
            self.n_s = sample_obs.shape[-1]
        
        # 动作空间
        # VMAS agents使用action_size（连续动作维度）
        vmas_action_size = self.vmas_env.agents[0].action_size
        
        # 确保是整数
        if hasattr(vmas_action_size, '__iter__'):
            vmas_action_size = int(vmas_action_size) if len(vmas_action_size) == 1 else sum(vmas_action_size)
        else:
            vmas_action_size = int(vmas_action_size)
        
        # 设置离散动作数量
        if self.continuous_actions:
            # 连续动作模式：我们定义离散到连续的映射
            # 对于2D空间，使用5个离散动作（4个主方向+停止）
            # 对于1D空间，使用3个离散动作（正、负、停止）
            if vmas_action_size == 2:
                self.n_a = 5  # 上下左右停止
            elif vmas_action_size == 1:
                self.n_a = 3  # 正负停止
            else:
                self.n_a = 2 * vmas_action_size + 1  # 每个维度2个方向+停止
        else:
            # 离散动作模式：直接使用VMAS定义的离散动作数量
            # VMAS在continuous_actions=False时自动将连续空间离散化
            # 通常是 3^dim 个动作（每个维度: 负/零/正）
            self.n_a = 3 ** vmas_action_size
        
        # 保存VMAS原始动作维度
        self.vmas_action_size = vmas_action_size
        
        # 为每个智能体设置相同的状态和动作维度
        self.n_s_ls = [self.n_s] * self.n_agent
        self.n_a_ls = [self.n_a] * self.n_agent
        
    def _build_neighbor_mask(self):
        """构建邻居mask（全连接图）"""
        # 默认使用全连接
        mask = np.ones((self.n_agent, self.n_agent))
        np.fill_diagonal(mask, 0)  # 自己不是自己的邻居
        return mask
    
    def _build_distance_mask(self):
        """构建距离mask（全连接图，距离为1）"""
        mask = np.ones((self.n_agent, self.n_agent), dtype=np.int32)
        np.fill_diagonal(mask, 0)
        return mask
    
    def reset(self, gui=False, test_ind=0):
        """重置环境
        
        Args:
            gui: 是否显示GUI（VMAS不支持，忽略）
            test_ind: 测试索引（用于选择测试seed）
        """
        obs = self.vmas_env.reset()
        self.cur_step = 0
        self.t = 0  # 重置时间步
        self.done_flag = False
        return self._process_obs(obs)
    
    def _process_obs(self, obs):
        """处理观测，转换为numpy数组列表
        
        对于 ia2c_fp 算法，需要在观测末尾附加邻居的 fingerprint
        """
        if self.obs_dict_mode:
            # Dict模式：{agent_name: obs_tensor}
            processed = []
            for agent_name in sorted(obs.keys()):
                agent_obs = obs[agent_name]
                if isinstance(agent_obs, dict):
                    # 嵌套字典，展平
                    flat_obs = torch.cat([v.flatten(-2) for v in agent_obs.values()], dim=-1)
                else:
                    flat_obs = agent_obs
                # 转numpy，取第一个环境
                processed.append(flat_obs[0].cpu().numpy())
        else:
            # Tuple模式：[obs_tensor_agent0, ...]
            processed = []
            for agent_obs in obs:
                if isinstance(agent_obs, dict):
                    flat_obs = torch.cat([v.flatten(-2) for v in agent_obs.values()], dim=-1)
                else:
                    flat_obs = agent_obs
                processed.append(flat_obs[0].cpu().numpy())
        
        # 对于 ia2c_fp 算法，附加邻居的 fingerprint
        if self.agent == 'ia2c_fp':
            fp = self.get_fingerprint()
            processed_with_fp = []
            for i in range(self.n_agent):
                cur_state = [processed[i]]
                # 附加邻居的 fingerprint
                for j in np.where(self.neighbor_mask[i] == 1)[0]:
                    cur_state.append(fp[j])
                processed_with_fp.append(np.concatenate(cur_state))
            return processed_with_fp
        
        return processed
    
    def step(self, actions):
        """
        执行动作
        
        Args:
            actions: list of arrays/ints, 每个智能体的动作（离散索引或连续向量）
        
        Returns:
            obs: list of arrays, 观测
            rewards: list of floats, 奖励
            done: bool, 是否结束
            info: dict, 额外信息
        """
        # 将动作转换为VMAS格式
        vmas_actions = []
        
        if self.continuous_actions:
            # 连续动作模式：需要转换离散索引到连续向量
            for action in actions:
                # 提取动作值
                if isinstance(action, torch.Tensor):
                    action_val = action.item() if action.numel() == 1 else action.cpu().numpy()
                else:
                    action_val = action
                
                # 判断是离散还是连续动作
                if isinstance(action_val, (int, np.integer)):
                    # 离散动作：映射到连续空间
                    action_cont = discrete_to_continuous_action(action_val, self.vmas_action_size)
                elif isinstance(action_val, np.ndarray):
                    if action_val.size == 1:
                        # 单值数组（离散动作）
                        action_cont = discrete_to_continuous_action(int(action_val), self.vmas_action_size)
                    else:
                        # 连续动作向量
                        action_cont = action_val.astype(np.float32)
                else:
                    # 其他情况（如float）：假设是单维离散动作
                    action_cont = discrete_to_continuous_action(int(action_val), self.vmas_action_size)
                
                # 转换为VMAS tensor (1, vmas_action_size)
                # 注意：VMAS内部某些操作期望float64，所以使用double()
                action_tensor = torch.from_numpy(action_cont.reshape(1, -1)).double().to(self.device_name)
                vmas_actions.append(action_tensor)
        else:
            # 离散动作模式：VMAS期望单个离散索引 (1, 1)
            for action in actions:
                # 提取动作值
                if isinstance(action, torch.Tensor):
                    action_val = action.item() if action.numel() == 1 else action.cpu().numpy()
                else:
                    action_val = action
                
                # 转换为整数索引
                if isinstance(action_val, (int, np.integer)):
                    action_idx = int(action_val)
                elif isinstance(action_val, np.ndarray):
                    action_idx = int(action_val.flat[0])
                else:
                    action_idx = int(action_val)
                
                # 创建 (1, 1) tensor包含离散索引
                action_tensor = torch.tensor([[action_idx]], dtype=torch.long, device=self.device_name)
                vmas_actions.append(action_tensor)
        
        # 执行步骤
        obs, rewards, dones, info = self.vmas_env.step(vmas_actions)
        
        # 处理输出
        processed_obs = self._process_obs(obs)
        
        # 处理奖励
        if isinstance(rewards, dict):
            processed_rewards = [rewards[name][0].item() for name in sorted(rewards.keys())]
        else:
            processed_rewards = [r[0].item() for r in rewards]
        
        # 计算global_reward（所有agent奖励的平均值）
        global_reward = float(sum(processed_rewards) / len(processed_rewards)) if processed_rewards else 0.0
        
        # 处理done
        if isinstance(dones, torch.Tensor):
            done = dones[0].item()
        else:
            done = dones
        
        self.cur_step += 1
        self.t += 1  # 更新时间步
        self.done_flag = done or (self.cur_step >= self.max_steps)
        
        return processed_obs, processed_rewards, self.done_flag, global_reward
    
    def get_state(self):
        """获取全局状态（用于某些算法）"""
        # 简单实现：连接所有智能体的观测
        obs = self._process_obs(self.vmas_env.reset())
        return np.concatenate(obs)
    
    def render(self, mode='human'):
        """渲染环境"""
        return self.vmas_env.render(
            mode=mode,
            agent_index_focus=None,
            visualize_when_rgb=False  # 改为False避免可视化挂起
        )
    
    def close(self):
        """关闭环境"""
        pass  # VMAS环境不需要显式关闭
    
    def terminate(self):
        """终止环境（与close()相同）"""
        self.close()
    
    def init_test_seeds(self, seeds):
        """初始化测试种子（用于评估）"""
        self.test_seeds = seeds
        self.test_seed_index = 0
    
    def update_fingerprint(self, fp):
        """更新fingerprint（用于IA2C-FP、MA2C-NC等算法）
        
        Args:
            fp: list of arrays，每个智能体的策略向量（维度为n_a）
        """
        self.fp = fp
    
    def get_fingerprint(self):
        """获取fingerprint（用于IA2C-FP、MA2C-NC等算法）
        
        Returns:
            list of arrays: 每个智能体的fingerprint向量（维度为n_a）
        """
        if not hasattr(self, 'fp'):
            # 如果没有fingerprint，返回均匀分布的策略向量（动作维度）
            uniform_policy = np.ones(self.n_a) / self.n_a
            self.fp = [uniform_policy.copy() for _ in range(self.n_agent)]
        return self.fp
    
    def get_avail_actions(self):
        """获取可用动作（用于离散动作空间）"""
        # 默认所有动作都可用
        return [[1] * self.n_a for _ in range(self.n_agent)]
    
    def get_neighbor_action(self, action):
        """获取每个智能体的邻居动作（用于IA2C等算法）"""
        action_array = np.array(action)
        naction = []
        for i in range(self.n_agent):
            # 获取邻居的动作
            neighbor_actions = action_array[self.neighbor_mask[i] == 1]
            naction.append(neighbor_actions)
        return naction


# VMAS场景推荐配置
VMAS_SCENARIO_CONFIGS = {
    'navigation': {
        'max_steps': 200,
        'n_obstacles': 2,
        'shared_rew': True,
        'observe_all_goals': False,
    },
    'transport': {
        'max_steps': 300,
        'n_packages': 1,
        'package_mass': 50,
    },
    'balance': {
        'max_steps': 250,
        'random_package_pos_on_line': True,
    },
    'sampling': {
        'max_steps': 200,
        'n_gaussians': 4,
        'shared_rew': True,
    },
    'flocking': {
        'max_steps': 200,
        'n_obstacles': 3,
    },
    'discovery': {
        'max_steps': 200,
        'n_targets': 5,
        'agents_per_target': 2,
    },
    'waterfall': {
        'max_steps': 200,
    },
    'give_way': {
        'max_steps': 150,
    },
    'wheel': {
        'max_steps': 200,
    },
    'passage': {
        'max_steps': 300,
    },
}
